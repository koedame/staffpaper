{
  "name": "staffpaper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm check && wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.156.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "undici": "^7.30.1",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    }
  }
}
